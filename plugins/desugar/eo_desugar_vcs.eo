; rule: not_or_elim
(program $eorx_not_or_elim ((Fs Bool) (i Int))
  :signature (Bool Type Int Type) Bool
  (
  (($eorx_not_or_elim Fs Bool i Int) (not (eo::list_nth or Fs i)))
  )
)
(program $eor_not_or_elim ((Fs Bool) (i Int))
  :signature (Int Bool) Bool
  (
  (($eor_not_or_elim i (not Fs)) ($eorx_not_or_elim Fs (eo::typeof Fs) i (eo::typeof i)))
  )
)
; verification: not_or_elim
(program $eovc_not_or_elim ((Fs Bool) (i Int))
