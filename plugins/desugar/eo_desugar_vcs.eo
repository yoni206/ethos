  (($eovc_implies_elim (_ (=> F1) F2))
     (eo::requires ($eo_model_sat (_ (=> F1) F2)) true
     (eo::requires ($eo_model_sat ($eor_implies_elim (_ (=> F1) F2))) false
       true)))
  )
)


