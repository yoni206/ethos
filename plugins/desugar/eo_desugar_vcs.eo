(include "eo_desugar_gen.eo")

;; proof rule specifications

; rule: scope
(program $eorx_scope ((F Bool) (G Bool))
  :signature (Bool Type Bool Type) Bool
  (
  (($eorx_scope F Bool G Bool) (_ (=> F) G))
  )
)
(program $eor_scope ((F Bool) (G Bool))
  :signature (Bool Bool) Bool
  (
  (($eor_scope G F) ($eorx_scope F (eo::typeof F) G (eo::typeof G)))
  )
)
; verification: scope
(program $eovc_scope ((F Bool) (G Bool))
  :signature (Bool Bool) Bool
  (
  (($eovc_scope G F)
     (eo::requires ($eo_model_sat G) true
     (eo::requires ($eo_model_sat ($eor_scope G F)) false
       true)))
  )
)


; rule: process_scope
(program $eorx_process_scope ((F Bool) (C Bool))
  :signature (Bool Type Bool Type) Bool
  (
  (($eorx_process_scope F Bool C Bool) ($run_process_scope F C))
  )
)
(program $eor_process_scope ((F Bool) (C Bool))
  :signature (Bool Bool) Bool
  (
  (($eor_process_scope C F) ($eorx_process_scope F (eo::typeof F) C (eo::typeof C)))
  )
)
; verification: process_scope
(program $eovc_process_scope ((F Bool) (C Bool))
  :signature (Bool Bool) Bool
  (
  (($eovc_process_scope C F)
     (eo::requires ($eo_model_sat F) true
     (eo::requires ($eo_model_sat ($eor_process_scope C F)) false
       true)))
  )
)


; rule: ite_eq
(program $eorx_ite_eq ((b Bool) (T Type) (t1 T) (t2 T))
  :signature (Bool Type T Type T Type) Bool
  (
  (($eorx_ite_eq b Bool t1 T t2 T) (eo::define ((_v0 (ite b))) (eo::define ((_v1 (= (_ (_ _v0 t1) t2)))) (_ (_ _v0 (_ _v1 t1)) (_ _v1 t2)))))
  )
)
(program $eor_ite_eq ((b Bool) (T Type) (t1 T) (t2 T))
  :signature (T) Bool
  (
  (($eor_ite_eq (_ (_ (ite b) t1) t2)) ($eorx_ite_eq b (eo::typeof b) t1 (eo::typeof t1) t2 (eo::typeof t2)))
  )
)
; verification: ite_eq
(program $eovc_ite_eq ((b Bool) (T Type) (t1 T) (t2 T))
  :signature (T) Bool
  (
  (($eovc_ite_eq (_ (_ (ite b) t1) t2))
     (eo::requires ($eo_model_sat ($eor_ite_eq (_ (_ (ite b) t1) t2))) false
       true))
  )
)


; rule: split
(program $eorx_split ((F Bool))
  :signature (Bool Type) Bool
  (
  (($eorx_split F Bool) (_ (or F) (_ (or (not F)) false)))
  )
)
(program $eor_split ((F Bool))
  :signature (Bool) Bool
  (
  (($eor_split F) ($eorx_split F (eo::typeof F)))
  )
)
; verification: split
(program $eovc_split ((F Bool))
  :signature (Bool) Bool
  (
  (($eovc_split F)
     (eo::requires ($eo_model_sat ($eor_split F)) false
       true))
  )
)


; rule: resolution
(program $eorx_resolution ((C1 Bool) (C2 Bool) (pol Bool) (L Bool))
  :signature (Bool Type Bool Type Bool Type Bool Type) Bool
  (
  (($eorx_resolution C1 Bool C2 Bool pol Bool L Bool) (eo::define ((_v0 (not L))) (eo::define ((_v1 (eo::ite pol _v0 L))) (eo::define ((_v2 ($to_clause C2))) (eo::define ((_v3 (eo::ite pol L _v0))) (eo::define ((_v4 ($to_clause C1))) ($from_clause (eo::list_concat or (eo::ite (eo::eq _v3 _v4) false (eo::list_erase or _v4 _v3)) (eo::ite (eo::eq _v1 _v2) false (eo::list_erase or _v2 _v1))))))))))
  )
)
(program $eor_resolution ((C1 Bool) (C2 Bool) (pol Bool) (L Bool))
  :signature (Bool Bool Bool Bool) Bool
  (
  (($eor_resolution pol L C1 C2) ($eorx_resolution C1 (eo::typeof C1) C2 (eo::typeof C2) pol (eo::typeof pol) L (eo::typeof L)))
  )
)
; verification: resolution
(program $eovc_resolution ((C1 Bool) (C2 Bool) (pol Bool) (L Bool))
  :signature (Bool Bool Bool Bool) Bool
  (
  (($eovc_resolution pol L C1 C2)
     (eo::requires ($eo_model_sat C1) true
     (eo::requires ($eo_model_sat C2) true
     (eo::requires ($eo_model_sat ($eor_resolution pol L C1 C2)) false
       true))))
  )
)


; rule: chain_resolution
(program $eorx_chain_resolution ((C1 Bool) (C2 Bool) (pols $eo_List) (lits $eo_List))
  :signature (Bool Type Bool Type $eo_List Type $eo_List Type) Bool
  (
  (($eorx_chain_resolution C1 Bool C2 Bool pols $eo_List lits $eo_List) ($chain_resolve_rec C1 C2 pols lits))
  )
)
(program $eor_chain_resolution ((C1 Bool) (C2 Bool) (pols $eo_List) (lits $eo_List))
  :signature ($eo_List $eo_List Bool) Bool
  (
  (($eor_chain_resolution pols lits (_ (and C1) C2)) ($eorx_chain_resolution C1 (eo::typeof C1) C2 (eo::typeof C2) pols (eo::typeof pols) lits (eo::typeof lits)))
  )
)
; verification: chain_resolution
(program $eovc_chain_resolution ((C1 Bool) (C2 Bool) (pols $eo_List) (lits $eo_List))
  :signature ($eo_List $eo_List Bool) Bool
  (
  (($eovc_chain_resolution pols lits (_ (and C1) C2))
     (eo::requires ($eo_model_sat (_ (and C1) C2)) true
     (eo::requires ($eo_model_sat ($eor_chain_resolution pols lits (_ (and C1) C2))) false
       true)))
  )
)


; rule: factoring
(program $eorx_factoring ((C Bool))
  :signature (Bool Type) Bool
  (
  (($eorx_factoring C Bool) ($from_clause (eo::list_setof or C)))
  )
)
(program $eor_factoring ((C Bool))
  :signature (Bool) Bool
  (
  (($eor_factoring C) ($eorx_factoring C (eo::typeof C)))
  )
)
; verification: factoring
(program $eovc_factoring ((C Bool))
  :signature (Bool) Bool
  (
  (($eovc_factoring C)
     (eo::requires ($eo_model_sat C) true
     (eo::requires ($eo_model_sat ($eor_factoring C)) false
       true)))
  )
)


; rule: reordering
(program $eorx_reordering ((C1 Bool) (C2 Bool))
  :signature (Bool Type Bool Type) Bool
  (
  (($eorx_reordering C1 Bool C2 Bool) (eo::requires (eo::list_minclude or C1 C2) true C2))
  )
)
(program $eor_reordering ((C1 Bool) (C2 Bool))
  :signature (Bool Bool) Bool
  (
  (($eor_reordering C2 C1) ($eorx_reordering C1 (eo::typeof C1) C2 (eo::typeof C2)))
  )
)
; verification: reordering
(program $eovc_reordering ((C1 Bool) (C2 Bool))
  :signature (Bool Bool) Bool
  (
  (($eovc_reordering C2 C1)
     (eo::requires ($eo_model_sat C1) true
     (eo::requires ($eo_model_sat ($eor_reordering C2 C1)) false
       true)))
  )
)


; rule: eq_resolve
(program $eorx_eq_resolve ((F1 Bool) (F2 Bool))
  :signature (Bool Type Bool Type) Bool
  (
  (($eorx_eq_resolve F1 Bool F2 Bool) F2)
  )
)
(program $eor_eq_resolve ((F1 Bool) (F2 Bool))
  :signature (Bool Bool) Bool
  (
  (($eor_eq_resolve F1 (_ (= F1) F2)) ($eorx_eq_resolve F1 (eo::typeof F1) F2 (eo::typeof F2)))
  )
)
; verification: eq_resolve
(program $eovc_eq_resolve ((F1 Bool) (F2 Bool))
  :signature (Bool Bool) Bool
  (
  (($eovc_eq_resolve F1 (_ (= F1) F2))
     (eo::requires ($eo_model_sat F1) true
     (eo::requires ($eo_model_sat (_ (= F1) F2)) true
     (eo::requires ($eo_model_sat ($eor_eq_resolve F1 (_ (= F1) F2))) false
       true))))
  )
)


; rule: modus_ponens
(program $eorx_modus_ponens ((F1 Bool) (F2 Bool))
  :signature (Bool Type Bool Type) Bool
  (
  (($eorx_modus_ponens F1 Bool F2 Bool) F2)
  )
)
(program $eor_modus_ponens ((F1 Bool) (F2 Bool))
  :signature (Bool Bool) Bool
  (
  (($eor_modus_ponens F1 (_ (=> F1) F2)) ($eorx_modus_ponens F1 (eo::typeof F1) F2 (eo::typeof F2)))
  )
)
; verification: modus_ponens
(program $eovc_modus_ponens ((F1 Bool) (F2 Bool))
  :signature (Bool Bool) Bool
  (
  (($eovc_modus_ponens F1 (_ (=> F1) F2))
     (eo::requires ($eo_model_sat F1) true
     (eo::requires ($eo_model_sat (_ (=> F1) F2)) true
     (eo::requires ($eo_model_sat ($eor_modus_ponens F1 (_ (=> F1) F2))) false
       true))))
  )
)


; rule: not_not_elim
(program $eorx_not_not_elim ((F Bool))
  :signature (Bool Type) Bool
  (
  (($eorx_not_not_elim F Bool) F)
  )
)
(program $eor_not_not_elim ((F Bool))
  :signature (Bool) Bool
  (
  (($eor_not_not_elim (not (not F))) ($eorx_not_not_elim F (eo::typeof F)))
  )
)
; verification: not_not_elim
(program $eovc_not_not_elim ((F Bool))
  :signature (Bool) Bool
  (
  (($eovc_not_not_elim (not (not F)))
     (eo::requires ($eo_model_sat (not (not F))) true
     (eo::requires ($eo_model_sat ($eor_not_not_elim (not (not F)))) false
       true)))
  )
)


; rule: contra
(program $eorx_contra ((F Bool))
  :signature (Bool Type) Bool
  (
  (($eorx_contra F Bool) false)
  )
)
(program $eor_contra ((F Bool))
  :signature (Bool Bool) Bool
  (
  (($eor_contra F (not F)) ($eorx_contra F (eo::typeof F)))
  )
)
; verification: contra
(program $eovc_contra ((F Bool))
  :signature (Bool Bool) Bool
  (
  (($eovc_contra F (not F))
     (eo::requires ($eo_model_sat F) true
     (eo::requires ($eo_model_sat (not F)) true
     (eo::requires ($eo_model_sat ($eor_contra F (not F))) false
       true))))
  )
)


; rule: and_elim
(program $eorx_and_elim ((Fs Bool) (i Int))
  :signature (Bool Type Int Type) Bool
  (
  (($eorx_and_elim Fs Bool i Int) (eo::list_nth and Fs i))
  )
)
(program $eor_and_elim ((Fs Bool) (i Int))
  :signature (Int Bool) Bool
  (
  (($eor_and_elim i Fs) ($eorx_and_elim Fs (eo::typeof Fs) i (eo::typeof i)))
  )
)
; verification: and_elim
(program $eovc_and_elim ((Fs Bool) (i Int))
  :signature (Int Bool) Bool
  (
  (($eovc_and_elim i Fs)
     (eo::requires ($eo_model_sat Fs) true
     (eo::requires ($eo_model_sat ($eor_and_elim i Fs)) false
       true)))
  )
)


