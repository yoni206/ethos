  (($eovc_not_or_elim i (not Fs))
     (eo::requires ($eo_model_sat (not Fs)) true
     (eo::requires ($eo_model_sat ($eor_not_or_elim i (not Fs))) false
       true)))
  )
)


; rule: implies_elim
(program $eorx_implies_elim ((F1 Bool) (F2 Bool))
  :signature (Bool Type Bool Type) Bool
  (
  (($eorx_implies_elim F1 Bool F2 Bool) (_ (or (not F1)) (_ (or F2) false)))
